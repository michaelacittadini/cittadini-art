---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArtCard from '../components/ArtCard.astro';
import { allWorks, seriesList } from '../lib/works';
import { site } from '../site.config';
import heroConf from '../data/hero.json';
import seriesOrder from '../data/series-order.json';
const works = await allWorks();
const featured = works.filter((w) => w.data.featured);
const hero = works.find((w) => w.id === heroConf.slug) ?? featured[0] ?? works[0];
const highlights = featured.filter((w) => w.id !== hero?.id).slice(0, 8);
const rank = (n) => { const i = seriesOrder.order.indexOf(n); return i < 0 ? 999 : i; };
const series = (await seriesList()).filter((s) => !(seriesOrder.hidden ?? []).includes(s.name)).sort((a, b) => rank(a.name) - rank(b.name));
---
<Base image={hero?.data.images[0]} jsonLd={{ '@context': 'https://schema.org', '@graph': [ { '@type': 'Person', '@id': `${Astro.site?.href}#misha`, name: site.name, alternateName: site.legalName, jobTitle: 'Abstract painter', description: site.description, url: Astro.site?.href, image: hero ? new URL(hero.data.images[0].src, Astro.site).href : undefined, nationality: 'Czech', birthPlace: 'Sokolov, Czechia', workLocation: { '@type': 'Place', name: 'ICB Building, Sausalito, California' }, alumniOf: ['Academy of Art University', 'Duquesne University'], knowsAbout: ['Abstract painting', 'Contemporary art', 'Collage'], email: `mailto:${site.email}`, sameAs: site.profiles }, { '@type': 'WebSite', '@id': `${Astro.site?.href}#site`, name: site.name, alternateName: 'Misha Cittadini Art', url: Astro.site?.href, publisher: { '@id': `${Astro.site?.href}#misha` } } ] }}>
  {hero && (
    <section class="hero">
      <figure class="hero-fig">
        <a href={`/works/${hero.id}/`}><Image src={hero.data.images[0]} alt={hero.data.alt ?? hero.data.title} widths={[640, 960, 1400]} sizes="(max-width: 800px) 100vw, 60vw" loading="eager" fetchpriority="high" /></a>
        <figcaption class="potm">Painting of the month: <a href={`/works/${hero.id}/`}><em>{hero.data.title}</em></a></figcaption>
      </figure>
      <div>
        <h1 class="sr-only">{site.name}</h1>
        <p><a class="btn primary" href="/works/">View works</a></p>
      </div>
    </section>
  )}
  {series.length > 0 && (
    <section aria-labelledby="series-h">
      <h2 id="series-h">Series</h2>
      <ul class="chips">{series.map((s) => <li><a href={`/works/series/${s.slug}/`}>{s.name}</a></li>)}</ul>
    </section>
  )}
  <section aria-labelledby="sel-h">
    <h2 id="sel-h">Selected works</h2>
    <div class="grid">{highlights.map((w) => <ArtCard work={w} />)}</div>
    <p><a href="/works/">All works &rarr;</a></p>
  </section>
</Base>
