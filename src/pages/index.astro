---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArtCard from '../components/ArtCard.astro';
import { allWorks, seriesList } from '../lib/works';
import { site } from '../site.config';
import heroConf from '../data/hero.json';
import seriesOrder from '../data/series-order.json';
const works = await allWorks();
const featured = works.filter((w) => w.data.featured);
const hero = works.find((w) => w.id === heroConf.slug) ?? featured[0] ?? works[0];
const highlights = featured.filter((w) => w.id !== hero?.id).slice(0, 8);
const rank = (n) => { const i = seriesOrder.order.indexOf(n); return i < 0 ? 999 : i; };
const series = (await seriesList()).filter((s) => !(seriesOrder.hidden ?? []).includes(s.name)).sort((a, b) => rank(a.name) - rank(b.name));
---
<Base image={hero?.data.images[0]} jsonLd={{ '@context': 'https://schema.org', '@type': 'Person', name: site.name, alternateName: site.legalName, jobTitle: 'Artist', url: Astro.site?.href, sameAs: [site.instagram] }}>
  {hero && (
    <section class="hero">
      <a href={`/works/${hero.id}/`}><Image src={hero.data.images[0]} alt={hero.data.alt ?? hero.data.title} widths={[640, 960, 1400]} sizes="(max-width: 800px) 100vw, 60vw" loading="eager" fetchpriority="high" /></a>
      <div>
        <h1>{site.name}</h1>
        <p class="lede">{site.tagline}{site.location ? `, ${site.location}` : ''}.</p>
        <p><a class="btn primary" href="/works/">View works</a> <a class="btn" href="/commissions/">Commissions</a></p>
        <p class="potm">Painting of the month: <a href={`/works/${hero.id}/`}><em>{hero.data.title}</em></a></p>
      </div>
    </section>
  )}
  {series.length > 0 && (
    <section aria-labelledby="series-h">
      <h2 id="series-h">Series</h2>
      <ul class="chips">{series.map((s) => <li><a href={`/works/series/${s.slug}/`}>{s.name}</a></li>)}</ul>
    </section>
  )}
  <section aria-labelledby="sel-h">
    <h2 id="sel-h">Selected works</h2>
    <div class="grid">{highlights.map((w) => <ArtCard work={w} />)}</div>
    <p><a href="/works/">All works &rarr;</a></p>
  </section>
</Base>
