---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Thank you" description="Thank you for your purchase.">
  <h1>Thank you</h1>
  <div class="prose">
    <p>Your order is confirmed and a receipt is on its way by email. Misha will be in touch within two working days about packing, shipping or delivery, and the certificate of authenticity.</p>
    <p>Questions: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </div>
</Base>
